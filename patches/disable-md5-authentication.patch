 {
+	/*
+	 * FIPS 140-3 Compliance: MD5 authentication is disabled.
+	 * MD5 is not a FIPS-approved algorithm and must not be used
+	 * for password authentication in FIPS mode.
+	 *
+	 * Use SCRAM-SHA-256 authentication instead (password_encryption = 'scram-sha-256')
+	 */
+	ereport(FATAL,
