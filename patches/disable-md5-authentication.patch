+			 errmsg("MD5 authentication is disabled for FIPS 140-3 compliance"),
+			 errdetail("MD5 is not a FIPS-approved algorithm."),
+			 errhint("Use SCRAM-SHA-256 authentication instead. Set password_encryption='scram-sha-256' and use 'scram-sha-256' method in pg_hba.conf.")));
 	char		md5Salt[4];		/* Password salt */
