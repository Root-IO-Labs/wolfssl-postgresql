@@ -145,6 +145,22 @@
 pg_md5_encrypt(const char *passwd, const char *salt, size_t salt_len,
 			   char *buf, const char **errstr)
 {
+	/*
+	 * FIPS 140-3 Compliance: Prevent creation of MD5 password hashes.
+	 * This function is used when password_encryption='md5' is set.
+	 * In FIPS mode, only SCRAM-SHA-256 should be used for password encryption.
+	 *
+	 * Note: This error will be triggered when:
+	 * 1. Creating a new user with PASSWORD
+	 * 2. Altering an existing user's password
+	 * 3. When password_encryption='md5' is set
+	 */
+	if (errstr)
+		*errstr = "MD5 password encryption is disabled for FIPS 140-3 compliance. "
+				  "Use SCRAM-SHA-256 instead (SET password_encryption = 'scram-sha-256').";
+
+	return false;
+
